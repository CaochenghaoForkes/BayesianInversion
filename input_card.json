{
    "schema_version": "1.0",

    "workflow": {
        "mode": "ask"
    },

    "study": {
        "name": "triso_bayesian_learning",
        "description": "TRISO扩散参数的贝叶斯反演"
    },

    "random_seed": 20260825,

    "parameters": [
        {"name": "log_D_pyc" ,"initial": -3.20066},
        {"name": "log_D_sic" ,"initial": -8.86009},
        {"name": "A_pyc" ,"initial": 222000.0},
        {"name": "A_sic" ,"initial": 125000.0}
    ],

    "prior": {
        "joint_prior": {
            "type": "independent"
        },
        "single_parameter_prior": {
            "log_D_pyc": {
                "lower": -4.20066,
                "upper": -2.20066,
                "type": "truncnorm",
                "truncnorm": {
                    "mean": -3.20066,
                    "sigma": 1.2
                }
            },
            "log_D_sic": {
                "lower": -9.86009,
                "upper": -7.86009,
                "type": "truncnorm",
                "truncnorm": {
                    "mean": -8.86009,
                    "sigma": 1.2
                }
            },
            "A_pyc": {
                "lower": 199800.0,
                "upper": 244200.0,
                "type": "truncnorm",
                "truncnorm": {
                    "mean": 222000.0,
                    "sigma": 10e3
                }
            },
            "A_sic": {
                "lower": 112500.0,
                "upper": 137500.0,
                "type": "truncnorm",
                "truncnorm": {
                    "mean": 125000.0,
                    "sigma": 10e3
                }
            }
        }
    },

    "data": {
        "datasets": [
            {
                "name": "experiment1",
                "source": {
                    "type": "csv",
                    "path": "SourceTermAnalysis/experiment1.csv",
                    "component_order": ["t1","release1"]
                }
            },
            {
                "name": "experiment2",
                "source": {
                    "type": "csv",
                    "path": "SourceTermAnalysis/experiment2.csv",
                    "component_order": ["t2","release2"]
                }
            },
            {
                "name": "experiment3",
                "source": {
                    "type": "csv",
                    "path": "SourceTermAnalysis/experiment3.csv",
                    "component_order": ["t3","release3"]
                }
            },
            {
                "name": "experiment4",
                "source": {
                    "type": "csv",
                    "path": "SourceTermAnalysis/experiment4.csv",
                    "component_order": ["t4","release4"]
                }
            }
        ]
    },

    "likelihood": {
        "joint_likelihood": {
            "data_order": ["experiment1","experiment2","experiment3","experiment4"],
            "distribution": {
                "type": "normal",
                "student_t": {
                    "degrees_of_freedom": 5.0
                }
            },
            "correlation": {
                "type": "block_matrix",
                "complete_matrix": {
                    "source": "correlation_matrix.csv"
                },
                "block_matrix": {
                    "experiment1_experiment2": {
                        "data_i": "experiment1",
                        "data_j": "experiment2",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    },
                    "experiment1_experiment3": {
                        "data_i": "experiment1",
                        "data_j": "experiment3",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    },
                    "experiment1_experiment4": {
                        "data_i": "experiment1",
                        "data_j": "experiment4",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    },
                    "experiment2_experiment3": {
                        "data_i": "experiment2",
                        "data_j": "experiment3",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    },
                    "experiment2_experiment4": {
                        "data_i": "experiment2",
                        "data_j": "experiment4",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    },
                    "experiment3_experiment4": {
                        "data_i": "experiment3",
                        "data_j": "experiment4",
                        "type": "independent",
                        "complete_matrix": {
                            "source": "y1_y2_matrix.csv"
                        },
                        "exponential": {
                            "length_scales": [10.0],
                            "correlation_value": 0.4
                        }
                    }
                }
            }
        },
        "single_data_likelihood": [
            {   
                "dataset": "experiment1",
                "value_component": "release1",
                "coordinate_components": ["t1"],
                "space": "log10",
                "point_correlation": {
                    "type": "exponential",
                    "complete_matrix": {
                        "source": "y1_point_correlation.csv"
                    },
                    "exponential": {
                        "length_scales": {
                            "t1": 1800
                        }
                    }
                },
                "sigma_exp": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                },
                "sigma_model": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                }
            },
            {   
                "dataset": "experiment2",
                "value_component": "release2",
                "coordinate_components": ["t2"],
                "space": "log10",
                "point_correlation": {
                    "type": "exponential",
                    "complete_matrix": {
                        "source": "y1_point_correlation.csv"
                    },
                    "exponential": {
                        "length_scales": {
                            "t2": 1800
                        }
                    }
                },
                "sigma_exp": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                },
                "sigma_model": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                }
            },
            {   
                "dataset": "experiment3",
                "value_component": "release3",
                "coordinate_components": ["t3"],
                "space": "log10",
                "point_correlation": {
                    "type": "exponential",
                    "complete_matrix": {
                        "source": "y1_point_correlation.csv"
                    },
                    "exponential": {
                        "length_scales": {
                            "t3": 1800
                        }
                    }
                },
                "sigma_exp": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                },
                "sigma_model": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                }
            },
            {   
                "dataset": "experiment4",
                "value_component": "release4",
                "coordinate_components": ["t4"],
                "space": "log10",
                "point_correlation": {
                    "type": "exponential",
                    "complete_matrix": {
                        "source": "y1_point_correlation.csv"
                    },
                    "exponential": {
                        "length_scales": {
                            "t4": 1800
                        }
                    }
                },
                "sigma_exp": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                },
                "sigma_model": {
                    "type": "relative",
                    "absolute": {
                        "value": 1.5
                    },
                    "relative": {
                        "ratio": 0.1
                    }
                }
            }
        ]
    },

    "model": {
        "type": "mars",
        "mars": {
            "work_dir": "SourceTermAnalysis",
            "case_map": {
                "exp1.xml": {
                    "datasets": {
                        "experiment1": {
                            "component_map": {
                                "t1": "time",
                                "release1": "release_rate"
                            }
                        }
                    }
                },
                "exp2.xml": {
                    "datasets": {
                        "experiment2": {
                            "component_map": {
                                "t2": "time",
                                "release2": "release_rate"
                            }
                        }
                    }
                },
                "exp3.xml": {
                    "datasets": {
                        "experiment3": {
                            "component_map": {
                                "t3": "time",
                                "release3": "release_rate"
                            }
                        }
                    }
                },
                "exp4.xml": {
                    "datasets": {
                        "experiment4": {
                            "component_map": {
                                "t4": "time",
                                "release4": "release_rate"
                            }
                        }
                    }
                }
            }
        }
    },

    "sampler": {
        "type": "emcee",
        "n_processes": 6,
        "burn_in": 2000,
        "production_steps": 8000,
        "thin": 2,
        "initial_spread": {
            "log_D_pyc": 0.08,
            "log_D_sic": 0.08,
            "A_pyc": 1000.0,
            "A_sic": 500.0
        },
        "emcee": {
            "n_walkers": 12,
            "move_weights": {
                "stretch": 0.0,
                "de": 0.8,
                "de_snooker": 0.2
            }
        }
    },

    "postprocess": {
        "separate_figures": true
    },

    "output": {
        "directory": "results/triso_bayesian_learning"
    }
}
